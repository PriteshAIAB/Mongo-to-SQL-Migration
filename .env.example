# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=test_db

# Microsoft SQL Server
SQL_USER=sa
SQL_PASSWORD=YourStrongPassword123!
SQL_SERVER=localhost
SQL_DATABASE=test_db
SQL_PORT=1433

# Optional: TLS (Azure / encrypted connections)
# SQL_ENCRYPT=true
# SQL_TRUST_SERVER_CERTIFICATE=false

# Optional: default batch size (documents per bulk insert)
# BATCH_SIZE=1000

# Optional: sample size for schema inference (default 100)
# SCHEMA_SAMPLE_SIZE=100

# Optional: parallel collection migrations (1 = sequential)
# MIGRATION_CONCURRENCY=2

# Optional: DRY_RUN=true — no CREATE TABLE / inserts (preview only). Default = real migration.
# DRY_RUN=false

# Optional: write logs/migration-*.log
# LOG_TO_FILE=false

# Optional: print generated CREATE TABLE SQL before each migration
# SQL_PREVIEW=true
